# Refuses a commit that stages a credential file or a file without the source header.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0
if printf '%s\n' "$staged" | grep -E -q '(^|/)\.env(\.|$)|\.env$|\.key$|\.pem$|\.p12$|\.crt$|(^|/)secrets/'; then
  echo "pre-commit: a credential file is staged; unstage it" >&2
  exit 1
fi
# The key name is assembled so this file's own text never matches the pattern.
key='API_KEY'
pattern="^\\+.*(sk-[A-Za-z0-9]{16,}|${key}=[\"']?[A-Za-z0-9_./+-]{20,})"
if git diff --cached -U0 -- $staged | grep -E -q "$pattern"; then
  echo "pre-commit: a staged hunk looks like a credential value" >&2
  exit 1
fi
# shellcheck disable=SC2086
printf '%s\n' "$staged" | sed "s#^#$root/#" | xargs -r python3 "$root/tools/header.py" --check
