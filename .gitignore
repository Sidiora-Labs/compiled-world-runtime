# Credentials and private configuration: never committed.
.env
.env.*
*.env
*.key
*.pem
*.p12
*.crt
secrets/
/spec/cwr/private/

# Build outputs.
/target/
**/target/
/out/
/xbuild/
/build/
/.cwr/
/artifacts/*
!/artifacts/README.md
!/artifacts/.gitkeep

# Python.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
/sdk/python/dist/

# Local tool state.
/.hyperfide/
/.codegraph/
*.kvx.lock
*.kvx.claim.lock
tmp/
*.swp
.DS_Store

# Campaign run artefacts that are not published. Published under benchmark/results
# are ledger.jsonl, final_state.kvx, attempt.kvx, the submitted messages that the
# analysis replays, and analyses; staging, replaced, pilot and superseded runs are
# working files of the harness.
/benchmark/results/_staging/
/benchmark/results/_replaced/
/benchmark/results/*/_pilot/
/benchmark/results/*/_superseded/
/benchmark/results/**/*.log
/benchmark/results/**/gateway.json

# Qualification runner work directories; evidence records live next to them.
/tests/cwr/evidence/.work/

# Python packaging output.
/sdk/python/build/
