[drift]
len_basis = "benchmark/suite.kvx [task.<id>].turns, the reference solution's turn count, recorded before any run"
turn_rule = "drift-1 at max(1, floor(len/2)); drift-3 at max(1, floor(len/4)), max(1, floor(len/2)), max(1, floor(3*len/4))"
selection = "rules ordered by sha256('cwr-h1-drift|<task>|<rule>'); templates taken level by level (A, B, C) over that order; first three distinct (primitive, template) pairs; drift-1 is the first pick, drift-3 is (second, first, third)"
change = "precondition_added; the manual, SDK and contracts.json are unchanged"
templates = {"fs.delete": [["A", "fs.size(path) <= 32", "LIMIT"], ["B", "fs.size(path) >= 1", "CONFLICT"], ["C", "jobs.active() == 0", "CONFLICT"]], "fs.lock": [["A", "fs.size(path) <= 32", "LIMIT"], ["B", "fs.size(path) >= 1", "CONFLICT"], ["C", "jobs.active() == 0", "CONFLICT"]], "fs.move": [["A", "fs.size(src) <= 32", "LIMIT"], ["B", "fs.size(src) >= 1", "CONFLICT"], ["C", "jobs.active() == 0", "CONFLICT"]], "fs.read": [["A", "fs.size(path) <= 32", "LIMIT"], ["B", "not fs.locked(path)", "LOCKED"], ["C", "jobs.active() == 0", "CONFLICT"]], "fs.size": [["A", "not fs.locked(path)", "LOCKED"], ["B", "jobs.active() == 0", "CONFLICT"], ["C", "jobs.active() <= 1", "LIMIT"]], "fs.unlock": [["A", "not fs.exists(path) or fs.size(path) <= 32", "LIMIT"], ["B", "fs.exists(path)", "NOT_FOUND"], ["C", "jobs.active() == 0", "CONFLICT"]], "fs.write": [["A", "not fs.exists(path)", "CONFLICT"], ["B", "len(content) <= 64", "LIMIT"], ["C", "jobs.active() == 0", "CONFLICT"]], "jobs.cancel": [["A", "jobs.status(id) == \"queued\"", "CONFLICT"], ["B", "jobs.active() <= 1", "LIMIT"], ["C", "len(id) <= 4", "INVALID"]], "jobs.result": [["A", "jobs.active() == 0", "CONFLICT"], ["B", "len(id) <= 4", "INVALID"], ["C", "jobs.active() <= 1", "LIMIT"]], "jobs.status": [["A", "jobs.active() <= 1", "LIMIT"], ["B", "len(id) <= 4", "INVALID"], ["C", "jobs.active() == 0", "CONFLICT"]], "jobs.submit": [["A", "jobs.active() < 2", "LIMIT"], ["B", "n <= 10", "LIMIT"], ["C", "len(kind) <= 6", "INVALID"]], "kv.del": [["A", "len(kv.keys(ns)) >= 2", "CONFLICT"], ["B", "len(key) <= 8", "INVALID"], ["C", "jobs.active() == 0", "CONFLICT"]], "kv.get": [["A", "len(key) <= 8", "INVALID"], ["B", "len(kv.keys(ns)) <= 4", "LIMIT"], ["C", "jobs.active() == 0", "CONFLICT"]], "kv.set": [["A", "not kv.has(ns, key)", "CONFLICT"], ["B", "len(value) <= 32", "LIMIT"], ["C", "len(key) <= 8", "INVALID"]], "publish.post": [["A", "len(title) <= 16", "INVALID"], ["B", "len(body) <= 256", "LIMIT"], ["C", "len(key) <= 8", "INVALID"]], "search.query": [["A", "limit <= 3", "LIMIT"], ["B", "len(q) <= 8", "INVALID"], ["C", "jobs.active() == 0", "CONFLICT"]]}

