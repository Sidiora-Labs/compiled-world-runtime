# CWR release pins (requirement 14.3, task 6.1). Procedure: RELEASE.md.
# Every value below that names a revision, digest, hash or checksum is written by
# `cwr release pin --write` and verified by `cwr release check`, which recompute each one from the
# tree. A pin that is null, malformed or different from its recomputation produces the named
# diagnostic in its section and blocks the release claim. Hash values use "sha256:<64 lowercase hex>".
# A revision is the sha256 tree digest of the published files of the component directory, in the
# layout of benchmark/predicates/common.py tree_digest. Published files are those the bundler selects
# (git ls-files --cached --others --exclude-standard) in a checkout, and every file in a bundle.
# meta.release, meta.status, meta.date and every path are set by the release owner, not by pin.
# Comments sit on their own lines: every value is a single JSON literal.

[meta]
format = "cwr.release"
schema_version = 2
status = "pinned; no release claim until closure and owner acceptance (task 6.2)"
release = "0.1.0"
date = "2026-11-06"
spec_sha256 = "sha256:3ff9997b4948cee9541a9b998d49467e1396fcb1a9c773c4e5854c95903449dd"
owner = "release"
tasks = ["6.1", "6.2"]

[pin.contract]
crate = "cwr-contract"
path = "crates/cwr-contract"
revision = "sha256:58bc3f162425c67088d25bf3d8444b474fe7dd5e041ce671c6c605f1cb580b4a"
diagnostic = "CWR-R016"

[pin.compiler]
crate = "cwr-compiler"
path = "crates/cwr-compiler"
revision = "sha256:cc98fa05e90f34a2f46939073f7dee23da252256d02b95658dfacf6303476a97"
diagnostic = "CWR-R001"

[pin.kernel]
crate = "cwr-kernel"
path = "crates/cwr-kernel"
revision = "sha256:9ce483d4de5ac0c23016b116662df86ebfad13d5606730749d5dafcf914ede89"
diagnostic = "CWR-R002"

[pin.sdk]
package = "cwr-sdk"
path = "sdk/python"
revision = "sha256:964705a16c46d1cea11678ef4e3955a046474e1675abb6830316f5a80973b020"
diagnostic = "CWR-R003"

[pin.cli]
crate = "cwr-cli"
path = "crates/cwr-cli"
revision = "sha256:c97f7b8ad35aaf4f5ad91b4e9270499794c4dd5ed3796e6fb4380574419efc96"
diagnostic = "CWR-R004"

# Every crate dependency is pinned by Cargo.lock; packaging builds with cargo --locked.
[dependencies]
cargo_lock = "sha256:cef33bd52b4e5cef1c89b10156df96b37557c0b63ae7673dd3b259059f607739"
diagnostic = "CWR-R017"

# The control Build every arm is measured against: built into an empty Build root. It must equal
# the control_build registered by every campaign file listed in "campaigns"; a listed file that is
# missing or unreadable is a diagnostic, never a skipped comparison.
[build.refworld_control]
source = "examples/refworld"
flag = null
campaigns = ["benchmark/campaigns/h1.kvx", "benchmark/campaigns/h2.kvx", "benchmark/campaigns/h3.kvx", "benchmark/campaigns/h4.kvx"]
hash = "sha256:c38c08f495b5df39a2d5930708d7845a88654f54caa1cb1897c6c9c04403985e"
diagnostic = "CWR-R005"

# Experimental Builds compiled from the control source, one per task and drift arm registered in
# the H1 campaign file; the drift file of each is regenerated from its registered schedule and the
# Build must equal the hash registered there. "hashes" maps "<task>/<arm>" to the Build hash.
[build.x_drift]
source = "examples/refworld"
flag = "--x-drift"
arms = ["drift-1", "drift-3"]
schedules = "benchmark/campaigns/h1.kvx"
