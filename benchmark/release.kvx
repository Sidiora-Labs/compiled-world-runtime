diagnostic = "CWR-R009"

# Both sides of each upgrade pair: A into an empty Build root, then B with --previous <A hash>.
# Each side and each notice ablation must equal the Build registered in "registered_in".
[build.upgrade_pairs]
source = "examples/refworld-upgrades"
expectations = "benchmark/upgrades.kvx"
registered_in = "benchmark/campaigns/h4.kvx"
pairs = ["U1", "U2", "U3", "U4", "U5", "U6"]
hashes = {"U1": {"a": "sha256:9bcc02e11dc3602ff880b1b3f6d9f7db3c756778abd8d5ff062627283b18a743", "b": "sha256:06e00c9b48d91f9cecfd232bcb79143dee1f01ddbcf042a6dc5fccaeb59cc08b"}, "U2": {"a": "sha256:c38c08f495b5df39a2d5930708d7845a88654f54caa1cb1897c6c9c04403985e", "b": "sha256:aa34586ff807cb9c5ccdff65a7b4965d98889992ed35d75f6b06317005687bf1"}, "U3": {"a": "sha256:baae898c50ed6d9f00adafcd6db82a28ced11cbf1ff40c060a485ca750087639", "b": "sha256:d2f5359a4eeea6008805ab2c71d01d719940a4a1c2efddf6806ed0f704d27136"}, "U4": {"a": "sha256:c38c08f495b5df39a2d5930708d7845a88654f54caa1cb1897c6c9c04403985e", "b": "sha256:a34c41bce04b44ee074c0ae844c495d07d483cf2f82f940901566c95205f6e63"}, "U5": {"a": "sha256:698d70fc85c7bbaf1b8d0fa9856137f684eaa4c62cad0a0f3f342fd5ac882197", "b": "sha256:c0dfab46247dd108a4174ee5541cf68e38c7227fe209268360663605c602281d"}, "U6": {"a": "sha256:c38c08f495b5df39a2d5930708d7845a88654f54caa1cb1897c6c9c04403985e", "b": "sha256:6abbbdb1a3206afdb873e1f8354c918ebe83ff90c63742a523157e0fcfeaa95a"}}
diagnostic = "CWR-R010"

# The digest of the suite cassette set (benchmark/cassettes/FORMAT.md section 5) that every campaign
# replays; must equal the cassette_digest frozen in benchmark/suite.kvx.
[cassettes]
path = "benchmark/cassettes/suite"
sets = "benchmark/cassettes/refworld.kvx"
frozen_in = "benchmark/suite.kvx"
digest = "sha256:c4d99f432d3f4fe76a04e5b3d8fc3d2db0d50785d3acfdaaaa9d2013234418e9"
diagnostic = "CWR-R011"

[suite]
