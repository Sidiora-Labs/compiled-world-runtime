# Notice ablations: side B of each upgrade pair built with the flag and --previous <side A hash>.
[build.x_version_only]
source = "examples/refworld-upgrades"
flag = "--x-version-only"
arms = ["version-only"]
hashes = {"U1": "sha256:02b712cea08a60a73592b4196b531e13e4748421e711493ff0f775c673bb16c8", "U2": "sha256:0bfcd7ec9e07d9f249420cf1d9a6487a14593d2ab1b8d6c0853a98bf022fd116", "U3": "sha256:ef441e74375175fe4695f1cbfb8be4e86146de7c4b42bd5502bb31d07517e4aa", "U4": "sha256:59607d9d5eea8bba541742e84d9b0dd29af7382ab9015c5fb11f35967baa6180", "U5": "sha256:060929f9a41f7ebb580a652ddf26281b525b7b91f89356073e59752ca25c2158", "U6": "sha256:3f12ee852c2af9666b351a8c819ccd248b12996691df110361782db99400bdd4"}
