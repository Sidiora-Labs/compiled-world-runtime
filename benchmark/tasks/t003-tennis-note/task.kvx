# Manifest for t003-tennis-note. The instruction given to the model is task.md; this file is
# harness metadata and is never rendered to the model.

[meta]
format = "cwr.task"
schema_version = 1

[task]
id = "t003-tennis-note"
title = "Note the top tennis hit"
bin = "short"
rules = ["search.query[shape]", "fs.write[2]:LIMIT"]
rule_reuse = false
reused_rule = null
files = ["task.md", "initial.kvx", "success.py", "bin", "rules", "task.kvx"]
solution = "benchmark/solutions/t003-tennis-note.py"
