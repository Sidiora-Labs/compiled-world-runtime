# Manifest for t012-config-fallback. The instruction given to the model is task.md; this file is
# harness metadata and is never rendered to the model.

[meta]
format = "cwr.task"
schema_version = 1

[task]
id = "t012-config-fallback"
title = "Back up a config file if present"
bin = "short"
rules = ["fs.read[1]:NOT_FOUND"]
rule_reuse = false
reused_rule = null
files = ["task.md", "initial.kvx", "success.py", "bin", "rules", "task.kvx"]
solution = "benchmark/solutions/t012-config-fallback.py"
