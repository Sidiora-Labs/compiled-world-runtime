# Manifest for t015-clear-session. The instruction given to the model is task.md; this file is
# harness metadata and is never rendered to the model.

[meta]
format = "cwr.task"
schema_version = 1

[task]
id = "t015-clear-session"
title = "Clear a kv namespace"
bin = "short"
rules = ["kv.del[1]:NOT_FOUND"]
rule_reuse = false
reused_rule = null
files = ["task.md", "initial.kvx", "success.py", "bin", "rules", "task.kvx"]
solution = "benchmark/solutions/t015-clear-session.py"
