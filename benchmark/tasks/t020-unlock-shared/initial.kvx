schema_version = 1
task = "t020-unlock-shared"

[fs]
files = {"/shared/a.txt": "shared file a\n", "/shared/b.txt": "shared file b\n", "/shared/c.txt": "shared file c\n", "/shared/d.txt": "shared file d\n", "/shared/e.txt": "shared file e\n"}
locks = ["/shared/a.txt", "/shared/c.txt", "/shared/e.txt"]

[kv]
namespaces = {}

[jobs]
jobs = {}
