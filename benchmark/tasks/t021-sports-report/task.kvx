# Manifest for t021-sports-report. The instruction given to the model is task.md; this file is
# harness metadata and is never rendered to the model.

[meta]
format = "cwr.task"
schema_version = 1

[task]
id = "t021-sports-report"
title = "Sports roundup"
bin = "medium"
rules = ["search.query[shape]", "fs.lock[2]:CONFLICT", "publish.post[key]:DUPLICATE_KEY", "kv.set[1]:INVALID"]
rule_reuse = false
reused_rule = null
files = ["task.md", "initial.kvx", "success.py", "bin", "rules", "task.kvx"]
solution = "benchmark/solutions/t021-sports-report.py"
