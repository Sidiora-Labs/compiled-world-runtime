[fs]
files = {"/config/app.ini": "host=stale\n", "/config/base.ini": "host=db.local\nport=5432\nuser=svc\npool=4\ntimeout=30\ntls=on\n", "/config/override.ini": "host=db.internal\nport=6543\npool=8\nregion=eu-west\n"}
locks = ["/config/app.ini"]

[kv]
namespaces = {}

[jobs]
jobs = {}
