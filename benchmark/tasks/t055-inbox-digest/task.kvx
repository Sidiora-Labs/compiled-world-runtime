# Manifest for t055-inbox-digest. The instruction given to the model is task.md; this file is
# harness metadata and is never rendered to the model.

[meta]
format = "cwr.task"
schema_version = 1

[task]
id = "t055-inbox-digest"
title = "Enrich and digest an inbox"
bin = "long"
rules = ["search.query[shape]", "publish.post[key]:DUPLICATE_KEY"]
rule_reuse = false
reused_rule = null
files = ["task.md", "initial.kvx", "success.py", "bin", "rules", "task.kvx"]
solution = "benchmark/solutions/t055-inbox-digest.py"
