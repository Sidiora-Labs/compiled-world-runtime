# Manifest for t059-search-catalogue. The instruction given to the model is task.md; this file is
# harness metadata and is never rendered to the model.

[meta]
format = "cwr.task"
schema_version = 1

[task]
id = "t059-search-catalogue"
title = "Build a search catalogue"
bin = "long"
rules = ["search.query[rate]:RATE_LIMITED", "search.query[shape]", "search.query[2]:LIMIT"]
rule_reuse = false
reused_rule = null
files = ["task.md", "initial.kvx", "success.py", "bin", "rules", "task.kvx"]
solution = "benchmark/solutions/t059-search-catalogue.py"
