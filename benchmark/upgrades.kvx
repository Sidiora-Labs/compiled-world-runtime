[pair.U5]
title = "State shape changed: kv becomes namespaced, with migration"
pair_class = "state_shape_changed"
task = "u5-read-migrated-receipts"
task_dir = "examples/refworld-upgrades/U5/task"
predicate = "examples/refworld-upgrades/U5/task/success.py"
source_a = "examples/refworld-upgrades/U5/A"
source_b = "examples/refworld-upgrades/U5/B"
a_equals_base = false
a_relation = "examples/refworld 0.2.0 with a flat kv (no ns parameter, one 64 KiB quota over the store): kv contract, lib, fixtures, manual prose and changelog history rewritten; no namespace migration"
b_relation = "examples/refworld 0.2.0 in every rule; version 0.3.0; the namespace migration is renamed migrations/0_2_0_0_3_0_kv_namespaces.py (same function body) with fixtures/kv/migration_0_3_0.kvx; changelog is A's plus release 0.3.0"
from_version = "0.2.0"
to_version = "0.3.0"
build_a = "sha256:c6e2cb893d6b046364965485f0fb51426079ffa419dcc05839c1d09b2425105b"
build_b = "sha256:9014c7375fd37746d7e84e9f23e7419f4e384cb3f41223d0b21dc4061ed520a2"
changes = ["kv_namespaces", "kv_get_ns", "kv_set_ns", "kv_set_ns_effects", "kv_del_ns", "kv_del_ns_effects"]
change_kinds = ["state_shape", "precondition_changed", "precondition_changed", "effect_changed", "precondition_changed", "effect_changed"]
migrations = ["migrations/0_2_0_0_3_0_kv_namespaces.py"]
changed_primitives = ["kv.del", "kv.get", "kv.has", "kv.keys", "kv.set", "kv.used"]
misuse_code = "INVALID"
misuse_secondary = {"primitive": "kv.get", "code": "NOT_FOUND"}
after_turn = 1
model_visible_effect = "The upgrade migrates every flat key into namespace default. After it every kv primitive takes ns first: an old-style kv.get(key=...) fails parameter validation with INVALID, and a guessed namespace such as receipts fails with NOT_FOUND at precondition 1. Only a model that reads the notice knows the old keys are under default."
misuse_definition = "A record of any kv primitive with code INVALID after the upgrade record (old-style call without ns). Not computable: the old-style call fails the SDK function signature inside the sandbox (turn.script) and writes no kv record, so the misuse rate is reported as undefined, never 0. A NOT_FOUND on kv.get with a guessed namespace is the secondary signature, recorded in misuse_secondary."
misuse_scope = "not_computable"

[diff.U5]
previous = "{hash_a}"
entries = [{"kind": "state_shape", "target": "kv", "field": "state"}, {"kind": "effect_changed", "target": "kv.del", "field": "effects", "before": ["not kv.has(key)"], "after": ["not kv.has(ns, key)"]}, {"kind": null, "target": "kv.del", "field": "params", "before": {"key": "str"}, "after": {"ns": "str", "key": "str"}}, {"kind": "precondition_changed", "target": "kv.del", "field": "preconditions", "before": [["kv.has(key)", "NOT_FOUND"]], "after": [["kv.has(ns, key)", "NOT_FOUND"]]}, {"kind": null, "target": "kv.get", "field": "params", "before": {"key": "str"}, "after": {"ns": "str", "key": "str"}}, {"kind": "precondition_changed", "target": "kv.get", "field": "preconditions", "before": [["kv.has(key)", "NOT_FOUND"]], "after": [["kv.has(ns, key)", "NOT_FOUND"]]}, {"kind": null, "target": "kv.has", "field": "params", "before": {"key": "str"}, "after": {"ns": "str", "key": "str"}}, {"kind": null, "target": "kv.keys", "field": "params", "before": {}, "after": {"ns": "str"}}, {"kind": "effect_changed", "target": "kv.set", "field": "effects", "before": ["kv.has(key)", "kv.get(key) == value"], "after": ["kv.has(ns, key)", "kv.get(ns, key) == value"]}, {"kind": null, "target": "kv.set", "field": "params", "before": {"key": "str", "value": "bytes"}, "after": {"ns": "str", "key": "str", "value": "bytes"}}, {"kind": "precondition_changed", "target": "kv.set", "field": "preconditions", "before": [["len(value) <= 1024", "INVALID"], ["kv.used() + len(value) <= 65536", "LIMIT"]], "after": [["len(value) <= 1024", "INVALID"], ["kv.used(ns) + len(value) <= 65536", "LIMIT"]]}, {"kind": null, "target": "kv.used", "field": "params", "before": {}, "after": {"ns": "str"}}]
