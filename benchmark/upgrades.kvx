# Copyright Sidiora Labs Inc. CWR® 2026-2027
# SPDX-License-Identifier: LicenseRef-Sidiora-DEV-OSS-1.0
# Upgrade pairs U1 to U6 for refworld: the frozen expectations of task 4.3 (clauses 5.2, 5.3, 11.4;
# cases CWR-011 and CWR-016) and the H4 pair plan of experiments.md section H4.
# Sources: examples/refworld-upgrades/UN/A and UN/B, generated from examples/refworld by
# examples/refworld-upgrades/pairs.py, which also checks this file against the sources.
# Status: authored by pairs.py, then exercised on the real compiler and kernel by the task 4.3 driver
# tests/cwr/cases/4_3.py, which also records build_a, build_b and reference_primitive_count
# (`--freeze`). The notice texts keep {hash_a} and {hash_b}: the driver substitutes the hashes of
# the Builds it compiles, because a hash changes with the compiler revision. This file is an
# expectation, not evidence; evidence is the driver's run.
# [pair.UN] is read by benchmark/analyse.py (task, changed_primitives, misuse_code, misuse_scope,
# predicate); misuse_scope is the argument of benchmark/harness/metrics.py post_upgrade_misuse_rate.

[meta]
format = "cwr.upgrades"
schema_version = 1
world = "refworld"
base_source = "examples/refworld"
base_version = "0.2.0"
pairs = ["U1", "U2", "U3", "U4", "U5", "U6"]
status = "authored; driven on the real compiler and kernel by tests/cwr/cases/4_3.py"
driver = "tests/cwr/cases/4_3.py"
hash_rule = "build_a and build_b are the hashes the driver observed at its last --freeze, each pair compiled into its own Build root with B built --previous A; they identify the compiler revision of that run and are recorded, not asserted."
sandbox_refusals = "On the kernel as built, the U2 pre-upgrade call to the removed fs.move and the U5 pre-upgrade kv.get without ns are refused inside the sandbox before any RPC: the turn ends error INVALID with primitive turn.script and the SDK's exception text, and no record names fs.move or kv.get. pre_failure freezes that observed record (detail_contains holds the exception text) and the driver compares it for equality. The post-upgrade misuse rate of U2 and U5 needs a ledger record naming the primitive, so it is not computable (misuse_scope not_computable; spec/cwr/qualification.kvx finding task_4_3_sandbox_refusal_misuse) until the SDK reports such calls as ledger call records."
generator = "examples/refworld-upgrades/pairs.py"
diff_layout = "spec/cwr/compiler.md section 5: entries sorted by target then field; kind null marks a params entry, for which world-source.md section 11 has no change kind"
coverage_rule_params = "A params entry is covered by a state_shape change whose target is the primitive's module in the same release (the convention of examples/refworld 0.2.0 change kv_namespaces). Open for task 1.2."
coverage_rule_doc = "A doc entry is covered by any change in the newest release with the same target, or by the module's state_shape change; a doc entry whose target has no other change needs a doc_only change. A doc_only change must match a doc entry. Open for task 1.2."
bump_rule = "Derived bump is the maximum over entries (params entries count as major). Pre-1.0 rule P15: while the major is 0, a minor increment satisfies a derived major and a patch increment satisfies a derived minor."
notice_template = "spec/cwr/model-surface.md section 5: header line; Summary line; blank; 'Changes affecting primitives this instance has used:'; per listed change '  <verb>  <target><label>', '    before  <before>', '    after   <after>' verbatim from CHANGELOG.kvx; blank; 'State was migrated. ' when a migration ran, then 'Your ledger is intact. The manual above describes <new version>.' Verbs: removed for primitive_removed, added for primitive_added, changed otherwise. Labels: ' (state shape)' for state_shape, ' (documentation)' for doc_only. A module target counts as used when any of its primitives was used. With nothing listed the list is '  (none)'."
notice_used_basis = "used_primitives is the set of primitives with a ledger record in the reference first half; a model's Instance may use a different set, and the kernel then lists the changes for that set by the same rule."
midpoint_rule = "upgrade_after_turn = number of first-half reference turns: the Instance runs on Build A for turns 1..upgrade_after_turn, is upgraded, and continues on Build B (experiments.md H4 protocol)."

[pair.U1]
title = "Precondition tightened: fs.delete refuses a locked path"
pair_class = "precondition_tightened"
task = "u1-delete-locked-batch"
task_dir = "examples/refworld-upgrades/U1/task"
predicate = "examples/refworld-upgrades/U1/task/success.py"
source_a = "examples/refworld-upgrades/U1/A"
source_b = "examples/refworld-upgrades/U1/B"
a_equals_base = false
a_relation = "examples/refworld 0.2.0 with fs.delete lacking precondition 2 (it deletes a locked file and releases its lock), with fs.delete and fs.lock docs, manual prose and changelog history to match"
b_relation = "examples/refworld 0.2.0 in every rule, file and fixture; version 0.3.0; changelog is A's plus release 0.3.0"
from_version = "0.2.0"
to_version = "0.3.0"
build_a = "sha256:a4e291c73bf9c67e3ab2a461602758c480764579d6a4e2318a5c20b3db5a830f"
build_b = "sha256:39c6e2595f33305b02c4824f10369ac6447c5711eef0d33e92b65880e9045ec0"
changes = ["fs_delete_refuses_locked", "fs_lock_doc_delete"]
change_kinds = ["precondition_added", "doc_only"]
migrations = []
changed_primitives = ["fs.delete"]
misuse_code = "LOCKED"
after_turn = 1
model_visible_effect = "Before the upgrade fs.delete removes a locked file. After it, fs.delete on a locked path fails with LOCKED at precondition 2 and the manual lists 'not fs.locked(path) else LOCKED'; the model must call fs.unlock first. State is unchanged by the upgrade."
misuse_definition = "An fs.delete record with code LOCKED after the upgrade record."
misuse_scope = "call"

[diff.U1]
previous = "{hash_a}"
entries = [{"kind": "precondition_added", "target": "fs.delete", "field": "preconditions", "before": [["fs.exists(path)", "NOT_FOUND"]], "after": [["fs.exists(path)", "NOT_FOUND"], ["not fs.locked(path)", "LOCKED"]]}]
doc_entries = [{"kind": "doc_only", "target": "fs.delete", "field": "doc", "before": "Remove the file at path, releasing its lock if it holds one. Refused when the path does not exist.", "after": "Remove the file at path. Refused when the path does not exist or is locked."}, {"kind": "doc_only", "target": "fs.lock", "field": "doc", "before": "Lock the existing file at path; while locked it cannot be written or moved; deleting it releases the lock. Refused when already locked.", "after": "Lock the existing file at path; while locked it cannot be written, deleted or moved. Refused when already locked."}]
doc_only_entries = 2
derived_bump = "major"
declared_bump = "minor"
pre_1_0_rule_applied = true

[notice.U1]
old_version = "0.2.0"
new_version = "0.3.0"
summary = "fs.delete now refuses a locked path with LOCKED; unlock the path before deleting it."
used_primitives = ["fs.delete", "fs.list"]
listed_targets = ["fs.delete"]
migrated = false
text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})\nSummary: fs.delete now refuses a locked path with LOCKED; unlock the path before deleting it.\n\nChanges affecting primitives this instance has used:\n  changed  fs.delete\n    before  fs.delete removed a locked file and released its lock.\n    after   not fs.locked(path), otherwise LOCKED (precondition 2); unlock the path before deleting it.\n\nYour ledger is intact. The manual above describes 0.3.0."
version_only_text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})"
silent_text = ""

[task.U1]
dir = "examples/refworld-upgrades/U1/task"
bin = "medium"
reference_turns = 2
upgrade_after_turn = 1
first_half = ["solutions/a1.py"]
post_upgrade = ["solutions/post2.py"]
pre_upgrade = ["solutions/pre2.py"]
pre_failure = {"primitive": "fs.delete", "code": "LOCKED", "precondition": 2}
reference_primitive_count = 12
count_source = "kernel"
post_success = true
pre_success = false

[pair.U2]
title = "Primitive removed: fs.move"
pair_class = "primitive_removed"
task = "u2-inbox-without-move"
task_dir = "examples/refworld-upgrades/U2/task"
predicate = "examples/refworld-upgrades/U2/task/success.py"
source_a = "examples/refworld-upgrades/U2/A"
source_b = "examples/refworld-upgrades/U2/B"
a_equals_base = true
a_relation = "byte-identical to examples/refworld 0.2.0"
b_relation = "examples/refworld without fs.move (contract, lib function and fixture removed) and with the fs.lock doc no longer mentioning moves; version 0.3.0"
from_version = "0.2.0"
to_version = "0.3.0"
build_a = "sha256:b3b9d2f3c8cebfda24216d860af03deb32b865e1a311b36f741a070f27111514"
build_b = "sha256:1294df5dab1dc51f9c96157e5d6913171a5b400c25c579ace413f679c738cde2"
changes = ["fs_move_removed", "fs_lock_doc_move"]
change_kinds = ["primitive_removed", "doc_only"]
migrations = []
changed_primitives = ["fs.move"]
misuse_code = "INVALID"
after_turn = 1
model_visible_effect = "After the upgrade fs.move is absent from the manual and the SDK; a call to it is a closure refusal (INVALID naming fs.move) and nothing executes. The model must rename with fs.read, fs.write and fs.delete. State is unchanged by the upgrade."
misuse_definition = "A record naming fs.move with code INVALID after the upgrade record. Not computable: the kernel refuses the call to the absent SDK function inside the sandbox (turn.script) and writes no record naming fs.move, so the misuse rate is reported as undefined, never 0."
misuse_scope = "not_computable"

[diff.U2]
previous = "{hash_a}"
entries = [{"kind": "primitive_removed", "target": "fs.move", "field": "primitive"}]
doc_entries = [{"kind": "doc_only", "target": "fs.lock", "field": "doc", "before": "Lock the existing file at path; while locked it cannot be written, deleted or moved. Refused when already locked.", "after": "Lock the existing file at path; while locked it cannot be written or deleted. Refused when already locked."}]
doc_only_entries = 1
derived_bump = "major"
declared_bump = "minor"
pre_1_0_rule_applied = true

[notice.U2]
old_version = "0.2.0"
new_version = "0.3.0"
summary = "fs.move is removed; to rename a file, read it, write the content to the new path and delete the old path."
used_primitives = ["fs.list", "fs.move"]
listed_targets = ["fs.move"]
migrated = false
text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})\nSummary: fs.move is removed; to rename a file, read it, write the content to the new path and delete the old path.\n\nChanges affecting primitives this instance has used:\n  removed  fs.move\n    before  fs.move(src, dst) renamed a file; refused when src was missing or locked or dst existed.\n    after   fs.move no longer exists; use fs.read, fs.write and fs.delete.\n\nYour ledger is intact. The manual above describes 0.3.0."
version_only_text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})"
silent_text = ""

[task.U2]
dir = "examples/refworld-upgrades/U2/task"
