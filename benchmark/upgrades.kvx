misuse_code = "INVALID"
after_turn = 1
model_visible_effect = "After the upgrade a kv.set of a value between 513 and 1024 bytes fails with INVALID at precondition 1; values stored before the upgrade keep their length. The model must split at 512 bytes. State is unchanged by the upgrade."
misuse_definition = "A kv.set record with code INVALID after the upgrade record."
misuse_scope = "call"

[diff.U4]
previous = "{hash_a}"
entries = [{"kind": "precondition_changed", "target": "kv.set", "field": "preconditions", "before": [["len(value) <= 1024", "INVALID"], ["kv.used(ns) + len(value) <= 65536", "LIMIT"]], "after": [["len(value) <= 512", "INVALID"], ["kv.used(ns) + len(value) <= 65536", "LIMIT"]]}]
doc_entries = [{"kind": "doc_only", "target": "kv.set", "field": "doc", "before": "Store value under key in namespace ns, replacing any previous value. Refused when the value exceeds 1024 bytes, or when the namespace's current usage plus the value would exceed 65536 bytes.", "after": "Store value under key in namespace ns, replacing any previous value. Refused when the value exceeds 512 bytes, or when the namespace's current usage plus the value would exceed 65536 bytes."}]
doc_only_entries = 1
derived_bump = "major"
declared_bump = "minor"
pre_1_0_rule_applied = true

[notice.U4]
old_version = "0.2.0"
new_version = "0.3.0"
summary = "kv.set now refuses values longer than 512 bytes with INVALID (the limit was 1024); values stored earlier are kept."
used_primitives = ["fs.read", "kv.set"]
listed_targets = ["kv.set"]
migrated = false
text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})\nSummary: kv.set now refuses values longer than 512 bytes with INVALID (the limit was 1024); values stored earlier are kept.\n\nChanges affecting primitives this instance has used:\n  changed  kv.set\n    before  len(value) <= 1024, otherwise INVALID (precondition 1).\n    after   len(value) <= 512, otherwise INVALID (precondition 1); values stored earlier keep their length.\n\nYour ledger is intact. The manual above describes 0.3.0."
version_only_text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})"
silent_text = ""

