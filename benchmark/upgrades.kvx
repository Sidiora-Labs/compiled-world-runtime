[pair.U3]
title = "Failure code changed: jobs.result before done is CONFLICT, not NOT_FOUND"
pair_class = "failure_code_changed"
task = "u3-poll-two-jobs"
task_dir = "examples/refworld-upgrades/U3/task"
predicate = "examples/refworld-upgrades/U3/task/success.py"
source_a = "examples/refworld-upgrades/U3/A"
source_b = "examples/refworld-upgrades/U3/B"
a_equals_base = false
a_relation = "examples/refworld 0.2.0 with jobs.result precondition 2 naming NOT_FOUND instead of CONFLICT, with the jobs.result doc, its fixture and manual prose to match"
b_relation = "examples/refworld 0.2.0 in every rule, file and fixture; version 0.3.0; changelog is A's plus release 0.3.0"
from_version = "0.2.0"
to_version = "0.3.0"
build_a = "sha256:93655455af0db2b9e567df225e1032d2eec9f70cb313a8cdfeda2abcb61f98b9"
build_b = "sha256:321b618371009cb19cf1d82cac2b6a4da973ca4d91567ff63d4c92e6649657d3"
changes = ["jobs_result_not_done_conflict"]
change_kinds = ["precondition_changed"]
migrations = []
changed_primitives = ["jobs.result"]
misuse_code = "CONFLICT"
after_turn = 2
model_visible_effect = "Before the upgrade a not-done job's jobs.result fails with NOT_FOUND, so scripts catch NOT_FOUND as 'not ready'. After it the same call fails with CONFLICT; a handler that catches only NOT_FOUND lets the exception escape and the turn ends in error. State is unchanged by the upgrade."
misuse_definition = "A post-upgrade turn whose turn record ends in error with code CONFLICT and whose last call record is a jobs.result failing with CONFLICT: the old handler caught only NOT_FOUND and let the new not-ready code escape. A caught CONFLICT is the documented not-ready signal on Build B and is correct use."
misuse_scope = "uncaught_turn"

[diff.U3]
previous = "{hash_a}"
entries = [{"kind": "precondition_changed", "target": "jobs.result", "field": "preconditions", "before": [["jobs.known(id)", "NOT_FOUND"], ["jobs.status(id) == \"done\"", "NOT_FOUND"]], "after": [["jobs.known(id)", "NOT_FOUND"], ["jobs.status(id) == \"done\"", "CONFLICT"]]}]
doc_entries = [{"kind": "doc_only", "target": "jobs.result", "field": "doc", "before": "Result of a finished job. Refused with NOT_FOUND until jobs.status reports done, as for an unknown id; poll the status, do not guess.", "after": "Result of a finished job. Refused with CONFLICT until jobs.status reports done; poll the status, do not guess."}]
doc_only_entries = 1
derived_bump = "major"
declared_bump = "minor"
pre_1_0_rule_applied = true

[notice.U3]
old_version = "0.2.0"
new_version = "0.3.0"
summary = "jobs.result on a job that is not done now fails with CONFLICT instead of NOT_FOUND; NOT_FOUND now means only an unknown id."
used_primitives = ["jobs.result", "jobs.submit", "kv.get", "kv.has", "kv.set"]
listed_targets = ["jobs.result"]
migrated = false
text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})\nSummary: jobs.result on a job that is not done now fails with CONFLICT instead of NOT_FOUND; NOT_FOUND now means only an unknown id.\n\nChanges affecting primitives this instance has used:\n  changed  jobs.result\n    before  jobs.status(id) == \"done\", otherwise NOT_FOUND (precondition 2), the same code as an unknown id.\n    after   jobs.status(id) == \"done\", otherwise CONFLICT (precondition 2); NOT_FOUND only for an unknown id.\n\nYour ledger is intact. The manual above describes 0.3.0."
version_only_text = "WORLD RECOMPILED  0.2.0 -> 0.3.0   ({hash_a} -> {hash_b})"
silent_text = ""

