a_relation = "byte-identical to examples/refworld 0.2.0"
b_relation = "examples/refworld with kv.set precondition 1 at 512 bytes, its doc, fixtures and the quota example to match; version 0.3.0"
from_version = "0.2.0"
to_version = "0.3.0"
build_a = "sha256:b3b9d2f3c8cebfda24216d860af03deb32b865e1a311b36f741a070f27111514"
