# Valid World Source fixture for the cwr-contract crate (task 0.3, case CWR-001).
# Every limit is explicit; there are no defaults.

[meta]
format = "cwr.world-source"
schema_version = 1

[world]
name = "fixtureworld"
version = "0.2.0"
language = "python"
runtime = "3.11"
modules = ["fs", "kv", "search"]

[limits]
cpu_ms = 5000
wall_ms = 30000
memory_mb = 256
primitive_calls = 500
adapter_calls = 50

[clock]
tick_per_primitive = 1
tick_per_turn = 10

[rng]
seed_visible = true
