# Drift schedule fixture.

[meta]
format = "cwr.drift"
schema_version = 1

[drift.1]
turn = 8
primitive = "fs.delete"
change = "precondition_added"
expr = "not fs.locked(path) and fs.size(path) < 4096"
failure = "LOCKED"
doc = "From turn 8, fs.delete refuses files of 4 KiB or more."
