# refworld changelog. One release section per version, newest first; each change names a kind from
# spec/cwr/world-source.md section 11, a target, the rule before and after, and a migration when the
# state shape changes. world.kvx version must equal the newest release.
# 0.2.0 carries three major-kind changes and is accepted at 0.2.0 only by the pre-1.0 rule (P15):
# while the major version is 0, a minor increment satisfies a derived major bump.

[meta]
format = "cwr.changelog"
schema_version = 1

[release.0.3.0]
version = "0.3.0"
date = "2026-11-06"
summary = "fs.delete now refuses a locked path with LOCKED; unlock the path before deleting it."
changes = ["fs_delete_refuses_locked", "fs_lock_doc_delete"]

[change.fs_delete_refuses_locked]
kind = "precondition_added"
target = "fs.delete"
before = "fs.delete removed a locked file and released its lock."
after = "not fs.locked(path), otherwise LOCKED (precondition 2); unlock the path before deleting it."
migration = ""

[change.fs_lock_doc_delete]
kind = "doc_only"
target = "fs.lock"
before = "The fs.lock description said that deleting a locked file releases the lock."
after = "The fs.lock description says that a locked file cannot be deleted."
migration = ""

[release.0.2.0]
version = "0.2.0"
date = "2026-11-06"
summary = "fs.write now refuses content above 1 MiB with LIMIT; kv keys are namespaced, with a 64 KiB quota per namespace readable through kv.used."
changes = ["fs_write_size_limit", "kv_namespaces", "kv_used_added", "kv_set_quota"]

[change.fs_write_size_limit]
kind = "precondition_added"
target = "fs.write"
before = "fs.write accepted any content length."
after = "len(content) <= 1048576, otherwise LIMIT."
migration = ""

[change.kv_namespaces]
kind = "state_shape"
target = "kv"
before = "kv state was one flat map of key to value and kv primitives took no namespace."
after = "kv state is a map of namespace to map of key to value and every kv primitive takes ns first; existing keys move to the default namespace."
migration = "migrations/0_2_0_kv_namespaces.py"

[change.kv_used_added]
kind = "primitive_added"
target = "kv.used"
before = ""
after = "kv.used(ns) returns the total byte length of the values stored in namespace ns."
migration = ""

[change.kv_set_quota]
kind = "precondition_added"
target = "kv.set"
before = "kv.set refused only values longer than 1024 bytes, with INVALID."
after = "kv.set additionally requires kv.used(ns) + len(value) <= 65536, otherwise LIMIT."
migration = ""

[release.0.1.0]
version = "0.1.0"
date = "2026-11-01"
summary = "First refworld release: fs, kv, jobs, search, publish and world modules."
changes = ["initial_fs", "initial_kv", "initial_jobs", "initial_search", "initial_publish", "initial_world"]

[change.initial_fs]
kind = "primitive_added"
target = "fs"
before = ""
after = "fs.exists, fs.locked, fs.size, fs.list, fs.read, fs.write, fs.delete, fs.lock, fs.unlock and fs.move exist; move refuses a locked source or an existing destination, and delete removes a locked file together with its lock."
migration = ""

[change.initial_kv]
kind = "primitive_added"
target = "kv"
before = ""
after = "kv.has, kv.get, kv.keys, kv.set and kv.del exist over one flat key space; kv.set refuses values longer than 1024 bytes with INVALID."
migration = ""

[change.initial_jobs]
kind = "primitive_added"
target = "jobs"
before = ""
after = "jobs.submit, jobs.known, jobs.status, jobs.active, jobs.result and jobs.cancel exist; jobs move from queued to running to done as a pure function of world time, at most 8 active at once."
migration = ""

[change.initial_search]
kind = "primitive_added"
target = "search.query"
before = ""
after = "search.query is an external adapter returning at most limit SearchHit records; content is not guaranteed."
migration = ""

[change.initial_publish]
kind = "primitive_added"
target = "publish"
before = ""
after = "publish.post, publish.status and publish.delete are external adapters; publish.post is idempotent by key and rate limited by the service; content is not guaranteed."
migration = ""

[change.initial_world]
kind = "primitive_added"
target = "world"
before = ""
after = "world.now, world.version, world.seed, world.limits, world.random, world.history and world.propose exist; world.propose has no effect inside the world."
migration = ""
