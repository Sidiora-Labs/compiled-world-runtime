world_time = 0
state = {}
prior = []
params = {"limit":51,"q":"tennis"}
expect = "LIMIT"
precondition = 2
request_hash = null
sequence = null
response = null

[case.service_invalid]
world_time = 0
state = {}
prior = []
params = {"limit":-1,"q":"tennis"}
expect = "INVALID"
precondition = null
request_hash = "sha256:57bb988c2c43bc63adef83da1c34ac9e1e6d0ea3a4854f59fdaa1d41f2a8ba68"
sequence = 1
response = {"body":{"code":"INVALID","detail":"limit must be non-negative"},"status":400}

