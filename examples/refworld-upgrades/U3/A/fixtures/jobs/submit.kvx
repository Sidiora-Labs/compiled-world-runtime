# Contract-test fixtures for jobs.submit. Each [case.<name>] is one ephemeral-Instance run:
# world_time and state are the initial conditions (state is keyed by module; modules not named start
# from their lib INITIAL_STATE), params is the call, expect is "ok" or the envelope code, precondition
# is the one-based index of the failing precondition or null, returned (optional) is the exact value an
# internal primitive must return. Value codec: a JSON string in a position typed bytes is its UTF-8
# encoding; {"$repeat": [s, n]} is the string s repeated n times; nothing else is special.

[meta]
format = "cwr.fixture"
schema_version = 1
module = "jobs"
primitive = "jobs.submit"

[case.pre_1_invalid]
world_time = 2
state = {"jobs": {"next_id": 4, "jobs": {"j1": {"kind": "render", "n": 5, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j2": {"kind": "index", "n": 3, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j3": {"kind": "crawl", "n": 50, "submitted": 0, "fail_at": 4, "cancelled_at": null}}}}
params = {"kind": "render", "n": 0}
expect = "INVALID"
precondition = 1

[case.pre_1_invalid_upper]
world_time = 2
state = {"jobs": {"next_id": 4, "jobs": {"j1": {"kind": "render", "n": 5, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j2": {"kind": "index", "n": 3, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j3": {"kind": "crawl", "n": 50, "submitted": 0, "fail_at": 4, "cancelled_at": null}}}}
params = {"kind": "render", "n": 1001}
expect = "INVALID"
precondition = 1

[case.pre_2_limit]
world_time = 2
state = {"jobs": {"next_id": 9, "jobs": {"j1": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j2": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j3": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j4": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j5": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j6": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j7": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j8": {"kind": "batch", "n": 100, "submitted": 0, "fail_at": null, "cancelled_at": null}}}}
params = {"kind": "render", "n": 5}
expect = "LIMIT"
precondition = 2

[case.ok]
world_time = 2
state = {"jobs": {"next_id": 4, "jobs": {"j1": {"kind": "render", "n": 5, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j2": {"kind": "index", "n": 3, "submitted": 0, "fail_at": null, "cancelled_at": null}, "j3": {"kind": "crawl", "n": 50, "submitted": 0, "fail_at": 4, "cancelled_at": null}}}}
params = {"kind": "render", "n": 5}
expect = "ok"
precondition = null
returned = "j4"
