# Starting Instance state for the post-upgrade task of pair U5, loaded on Build A (refworld 0.2.0 flat kv; the [kv] section is the flat key map itself).
# Layout as benchmark/tasks/*/initial.kvx: one section per module, keys are that module's state fields.
# File contents and kv values are UTF-8 text.

[meta]
format = "cwr.task-state"
schema_version = 1
pair = "U5"
side = "A"

[fs]
files = {}
locks = []

[kv]
receipt-golf = "p_0001"
receipt-tennis = "p_0002"
receipt-chess = "p_0003"
