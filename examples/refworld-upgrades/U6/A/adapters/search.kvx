# Adapter contract for the search module: the tennis-versus-golf case. The call shape, the result
# shape and the failure codes are rules; which documents come back is content and is not guaranteed.
# Backed by the stub server benchmark/stubs/search_server.py (ten queries per 50 ticks, then
# RATE_LIMITED). Gateway-side implementation: adapters/search/live.py.

[meta]
format = "cwr.adapter"
schema_version = 1
module = "search"

[adapter.search.query]
side_effect = "external"
params = {"q": "str", "limit": "int"}
returns = "list[SearchHit]"
preconditions = [["len(q) > 0", "INVALID"], ["limit <= 50", "LIMIT"]]
idempotency = "none"
timeout_ms = 3000
failures = ["INVALID", "LIMIT", "RATE_LIMITED", "UNAVAILABLE", "TIMEOUT"]
content_guaranteed = false
endpoint = "stub://search/v1/query"
doc = "Search the external index. Returns at most limit hits with the SearchHit shape; the hits themselves are not guaranteed and may differ between calls."
