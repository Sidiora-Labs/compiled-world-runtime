# Contract-test fixtures for fs.size. Each [case.<name>] is one ephemeral-Instance run:
# world_time and state are the initial conditions (state is keyed by module; modules not named start
# from their lib INITIAL_STATE), params is the call, expect is "ok" or the envelope code, precondition
# is the one-based index of the failing precondition or null, returned (optional) is the exact value an
# internal primitive must return. Value codec: a JSON string in a position typed bytes is its UTF-8
# encoding; {"$repeat": [s, n]} is the string s repeated n times; nothing else is special.

[meta]
format = "cwr.fixture"
schema_version = 1
module = "fs"
primitive = "fs.size"

[case.pre_1_not_found]
world_time = 0
state = {"fs": {"files": {"/notes/a.md": "alpha", "/notes/b.md": "beta", "/inbox/1.txt": "one"}, "locks": []}}
params = {"path": "/missing"}
expect = "NOT_FOUND"
precondition = 1

[case.ok]
world_time = 0
state = {"fs": {"files": {"/notes/a.md": "alpha", "/notes/b.md": "beta", "/inbox/1.txt": "one"}, "locks": []}}
params = {"path": "/notes/b.md"}
expect = "ok"
precondition = null
returned = 4
