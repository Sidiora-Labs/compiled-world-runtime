[sync]
 auto = true            

[paths]
 spec    = "spec"       
 context = ".hyperfide/context"    
 skills  = ".agents/skills"  
 codemap = "CODEMAP.md" 

[index]
workers = auto       
walk = auto          

[projection]
base    = "main"     
stale   = "24h"      
exclude = []         
index   = false      
steer   = true       
auto    = true       
min_interval = "15s"

[fleet]
discover = true      

[hooks]
shell_advice = true  
