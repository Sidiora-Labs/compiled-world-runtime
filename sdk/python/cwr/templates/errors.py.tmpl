"""Typed exceptions of the CWR Build {{WORLD}} {{VERSION}}: one class per failure code.

Generated by the CWR compiler from the envelope in contracts.json; never edited by hand. A refused
primitive call raises the class of its code. Every exception carries code, primitive,
precondition_index (one-based, or None), retry_after (ticks, RATE_LIMITED only, else None), limit
(LIMIT only, else None) and detail. Catch WorldError to handle every code.
"""

__all__ = {{ALL_LITERAL}}

CODES = {{CODES_LITERAL}}


class WorldError(Exception):
    """A primitive call refused by the world with a code from the closed failure envelope."""

    code = None

    def __init__(self, primitive, precondition_index=None, retry_after=None, limit=None, detail=""):
        self.primitive = primitive
        self.precondition_index = precondition_index
        self.retry_after = retry_after
        self.limit = limit
        self.detail = detail
        where = f" (precondition {precondition_index})" if precondition_index is not None else ""
        extra = f" retry_after={retry_after}" if retry_after is not None else ""
        extra += f" limit={limit}" if limit is not None else ""
        super().__init__(f"{self.code} from {primitive}{where}{extra}: {detail}")
{{CLASSES}}

BY_CODE = {{BY_CODE_LITERAL}}


def from_failure(failure):
    """The exception for a failure value of the per-call result envelope."""
    cls = globals()[BY_CODE[failure["code"]]]
    return cls(
        failure["primitive"],
        failure.get("precondition_index"),
        failure.get("retry_after"),
        failure.get("limit"),
        failure.get("detail", ""),
    )
