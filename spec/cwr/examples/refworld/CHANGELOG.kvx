# Illustrative changelog for refworld. Each release lists its change ids; each change names a kind,
# a target, the rule before and after, and a migration file when state shape changes.

[meta]
format = "cwr.changelog"
schema_version = 1
example = true

[release.0.2.0]
version = "0.2.0"
date = "2026-11-06"
summary = "fs.write now refuses content above 1 MiB with LIMIT; kv keys are namespaced per job."
changes = ["fs_write_size_limit", "kv_namespaces"]

[change.fs_write_size_limit]
kind = "precondition_added"
target = "fs.write"
before = "fs.write accepted any content length."
after = "len(content) <= 1048576, otherwise LIMIT."
migration = ""

[change.kv_namespaces]
kind = "state_shape"
target = "kv"
before = "kv state was one flat map of key to value."
after = "kv state is a map of namespace to map of key to value; existing keys move to the default namespace."
migration = "migrations/0_2_0_kv_namespaces.py"

[release.0.1.0]
version = "0.1.0"
date = "2026-11-01"
summary = "First refworld release: fs, kv, jobs, search, publish and world modules."
changes = ["initial_modules"]

[change.initial_modules]
kind = "primitive_added"
target = "fs.read"
before = ""
after = "All module primitives listed in contracts/ and adapters/ exist with their documented rules."
migration = ""
