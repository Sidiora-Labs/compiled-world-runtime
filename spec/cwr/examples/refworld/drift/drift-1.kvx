# Illustrative drift specification for an H1 ablation Build (--x-drift). One rule change is injected
# at the named turn without changing the manual. The kernel logs the injection as a ledger record of kind drift.

[meta]
format = "cwr.drift"
schema_version = 1
example = true

[drift.1]
turn = 8
primitive = "fs.delete"
change = "precondition_added"
expr = "not fs.locked(path) and fs.size(path) < 4096"
failure = "LOCKED"
doc = "From turn 8, fs.delete additionally refuses files of 4 KiB or more with LOCKED while the manual still documents the original rule."
