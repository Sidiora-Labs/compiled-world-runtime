# Deviation of tasks 4.1 and 4.2 (clauses 11.2, 11.3; reference-world.md section 4): stub-side rate
# limits are not reproduced in replay mode.
[finding.task_4_2_rate_limits_not_replayed]
revision = "working-tree crates/cwr-kernel/src/gateway/mod.rs, benchmark/tasks 2026-11-06"
command = "python3 benchmark/tasks/_authoring/build_suite.py --check"
exit_code = 0
log = "stdout of build_suite.py; it refuses any [rate] rule with 'rate limits are not enforced in replay mode'"
observed = "The publish stub accepts three posts per 100 ticks and the search stub ten queries per 50 ticks. Replay serves cassette entries keyed by adapter, request hash and sequence, never by world_time, and the reference recordings never hit a limit, so four publish.post calls in one replayed turn all return ok. A [rate] rule can never fire in a campaign, rate_limited_beyond_first is always 0, and a rule-reuse score on a rate rule is vacuously 1."
assumption = "Until the gateway's replay path enforces what the stubs enforce (by running the deterministic stub core in-process, or by recording RATE_LIMITED entries past the window), no task lists a [rate] rule: they were removed from t022, t027, t030, t046, t047, t048, t055 and t059. t046 now reuses publish.post[1]:INVALID (two source files open with a line longer than the 200-character title limit) and t048 reuses search.query[2]:LIMIT (the instruction asks for the largest limit the service accepts). The reference solutions still wait out the live windows, so recording against the stubs is unchanged in kind. The suite, cassette and campaign digests of the earlier registration are superseded by this change."
product_evidence = false

# Deviation of task 4.2 (clause 11.3): an adapter task is solvable in replay only with the reference
# solution's exact request bytes.
[finding.task_4_2_replay_exact_requests]
revision = "working-tree benchmark/tasks, crates/cwr-kernel/src/gateway/mod.rs 2026-11-06"
command = "python3 tests/cwr/cases/4_2.py"
exit_code = 0
log = "stdout of tests/cwr/cases/4_2.py, CLAUSE 11.3 (key release after a cassette miss on t008)"
observed = "Replay answers a request only when its canonical parameters equal a recorded one; any other request misses the cassette and gets UNAVAILABLE. task.md now pins every adapter parameter the predicates bind (limits, idempotency keys, titles and exact bodies, including trailing newlines) for t003, t021, t022, t029, t046, t047, t048, t055, t058 and t060, and the predicates check the pinned requests through the gateway request hash (common.called_with). The gateway no longer stores a cassette miss as a key adapter's first outcome: the slot is released, so a corrected call under the pinned key still succeeds."
assumption = "A well-formed request that differs from the recording, for example a search with another limit the instruction leaves open, still misses the cassette. Resolving this needs replay to answer any well-formed request deterministically from the stub core instead of a request-keyed lookup."
product_evidence = false

# Deviation of experiments.md section 3.1 for campaign H1: drift turns of single-turn tasks.
[finding.task_4_2_single_turn_drift]
revision = "working-tree benchmark/tasks, benchmark/suite.kvx 2026-11-06"
command = "python3 tests/cwr/cases/4_2.py --write-counts FILE; python3 benchmark/tasks/_authoring/build_suite.py --kernel-counts FILE"
exit_code = 0
log = "benchmark/suite.kvx [task.<id>].turns"
observed = "H1 injects drift at max(1, floor(len/2)) with len the reference turn count. The rule-reuse tasks t042, t043, t044, t045, t050, t051, t053 and t054 had one-turn reference solutions, so every drift landed on turn 1 before any call; each 'Do these steps in order' phase is now its own turn, giving three turns. Every short and most medium tasks still have a one-turn reference solution, so their drift is injected before the first call and H1 compares two static worlds for them."
assumption = "A drift point placed by primitive-call position (inject before call index k) would make drift mid-task for every task; that is a change to the drift injector and the campaign harness, not to the suite. Until then H1 results for one-turn tasks measure a changed world, not a world that changes mid-task, and the report says so."
product_evidence = false

# Deviation of task 4.3 (clause 12.4, metric post_upgrade_misuse_rate) for pairs U2 and U5.
[finding.task_4_3_sandbox_refusal_misuse]
revision = "working-tree benchmark/upgrades.kvx, benchmark/harness/metrics.py 2026-11-06"
command = "python3 tests/cwr/cases/4_3.py"
exit_code = 0
log = "stdout of tests/cwr/cases/4_3.py, NOTE sandbox-side refusal lines and CLAUSE 11.4"
observed = "The U2 call to the removed fs.move and the U5 kv.get without ns fail inside the sandbox before any RPC: the turn ends error INVALID on turn.script with the SDK's exception text and no ledger record names the primitive. upgrades.kvx now freezes that observed record (pre_failure with detail_contains) and the driver compares it for equality. Their misuse_scope is not_computable, so the misuse rate is None for U2 and U5 and they drop out of the pooled H4 misuse estimate instead of counting as 0. U3 misuse is now an uncaught jobs.result CONFLICT that ends the turn in error (misuse_scope uncaught_turn), because a caught CONFLICT is correct use on Build B."
assumption = "Requirement 12 asks for misuse from ledgers. U2 and U5 meet it once the SDK reports a call to an absent primitive or with a bad signature as a ledger call record naming the primitive."
product_evidence = false

# Deviation of reference-world.md section 4 and the refworld manual: reconciliation after TIMEOUT.
[finding.refworld_timeout_reconciliation]
revision = "examples/refworld 0.2.0 (manual/conventions.md, adapters/publish.kvx)"
command = "python3 benchmark/stubs/record_refworld.py replay --set adapters --out DIR"
exit_code = 0
log = "benchmark/cassettes/refworld-adapters timeout scenario"
observed = "The manual and the publish.status doc tell the model to reconcile a TIMEOUT on publish.post with publish.status before posting under a new key. publish.status takes a post_id, which the model never receives after a TIMEOUT; an identical replay returns the stored TIMEOUT; and the stub completes the side effect before answering late, so the advised new-key repost can create a duplicate post."
assumption = "The fix is a key-addressed status (publish.lookup(key) in the adapter contract and the stub) or the deterministic post id in the TIMEOUT detail, with the manual and reference-world.md section 4 rewritten to match. Any byte of examples/refworld changes the refworld Build hash that arms.kvx, the upgrade pairs and every cassette set record, so the change is made together with the next re-registration of the campaigns, not inside this review."
product_evidence = false
